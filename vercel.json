{
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "rewrites": [
        {
            "source": "/playlist.m3u",
            "destination": "/api/index.py"
        },
        {
            "source": "/",
            "destination": "/api/index.py"
        }
    ],
    "crons": [
        {
            "path": "/playlist.m3u",
            "schedule": "35 22 * * *"
        },
        {
            "path": "/playlist.m3u",
            "schedule": "0 6 * * *"
        }
    ]
}